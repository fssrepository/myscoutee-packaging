{
  "schemaVersion": 1,
  "control": {
    "Section": "web",
    "Priority": "optional",
    "Maintainer": "MyScoutee <admin@myscoutee.local>",
    "Depends": "passwd, bash, coreutils, curl, jq, openssl, python3, systemd, tar, util-linux, docker.io | docker-ce, docker-compose-plugin | docker-compose-v2",
    "Recommends": "gnupg, ufw, ncdu, iotop, redis-tools"
  },
  "lifecycle": {
    "bootstrapTls": {
      "temporaryPrefix": ".myscoutee-bootstrap-tls.",
      "days": 3650,
      "key": "rsa:2048",
      "certificate": "nginx.crt",
      "privateKey": "nginx-nopass.key",
      "subject": "/CN=localhost",
      "alternativeNames": "subjectAltName=DNS:localhost,IP:127.0.0.1"
    },
    "mongoDatabase": "production_db",
    "firebaseEnabled": false,
    "requiredImages": [
      {
        "environment": "MONGO_IMAGE",
        "default": "mongo:8.0.4",
        "label": "MongoDB"
      },
      {
        "environment": "REDIS_IMAGE",
        "default": "redis:8.6.1-alpine",
        "label": "Redis"
      }
    ]
  }
}
